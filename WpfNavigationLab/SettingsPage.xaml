<Page x:Class="WpfNavigationLab.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfNavigationLab"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SettingsPage"
      Background="White">

    <Grid Margin="40">
        <StackPanel>

            <TextBlock Text="Beállítások"
               FontSize="32"
               FontWeight="Bold"
               Foreground="#1E293B"/>

            <CheckBox Content="Értesítések engedélyezése" Margin="24, 20, 0, 20"></CheckBox>

                <Button Content="Vissza"
            Height="45"
            Click="Back_Click"/>

        </StackPanel>
    </Grid>
</Page>
