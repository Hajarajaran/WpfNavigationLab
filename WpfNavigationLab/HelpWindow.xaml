<Window x:Class="WpfNavigationLab.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfNavigationLab"
        mc:Ignorable="d"
        Title="HelpWindow" Height="450" Width="800">
    <Grid Margin="30">

        <StackPanel>

            <TextBlock Text="Help Window"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#1E293B"
                   HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <Button Content="Ablak bezárása"
                Height="45"
                Click="Close_Click"/>

        </StackPanel>

    </Grid>
</Window>
