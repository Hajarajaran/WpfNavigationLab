<Page x:Class="WpfNavigationLab.ContactPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfNavigationLab"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ContactPage">

    <Grid Margin="40">

        <StackPanel>

            <TextBlock Text="Kapcsolat"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#1E293B"/>

            <TextBlock Text="Telefonszám: +36-12-345-6789"
                       FontWeight="Bold" Margin="0,20,0,10"/>

            <TextBlock Text="E-mail: kapcsolat@gmail.com"
                       FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock TextWrapping="Wrap"
                       Margin="0,0,0,20"
                       Text="A Page használatát választottam, mert a kapcsolati adatokat elég egy egyszerű menüpontként megjeleníteni, ami a Frame tartalmát cseréli. Mivel nem kér be adatokat, és nincsen összetettebb logika vagy interakció, amit le kéne futtatnia, ezért elég egy egyszerű Page is."/>

            <Button Content="Beállítások megtekintése"
                    Height="45" Margin="0,0,0,10"
                    Click="GoToSettings_Click"/>

            <Button Content="Vissza"
                    Height="45"
                    Click="Back_Click"/>

        </StackPanel>

    </Grid>
</Page>
